# Copy this file to ".env" if you need to change the defaults.
# IMPORTANT: anything starting with VITE_ is bundled into the public JavaScript.
# Never put secrets in a VITE_ variable.

# Base URL the browser uses for API calls. "/api" works in development
# (Vite proxies it to the backend) and behind a reverse proxy in production.
VITE_API_BASE_URL=/api

# Development only (not exposed to the browser): where Vite forwards /api requests.
DEV_API_TARGET=http://localhost:4000
