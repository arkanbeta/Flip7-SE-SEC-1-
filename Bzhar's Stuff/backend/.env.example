# Copy this file to ".env" and replace the placeholders. Never commit ".env".

NODE_ENV=development
PORT=4000

# Exact origin of the frontend (scheme + host + port, no trailing slash).
# Used to restrict CORS and as the target of redirects after login.
CLIENT_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the backend (0 = none, e.g. local development).
TRUST_PROXY=0

# MySQL (8.0.16 or newer)
DB_HOST=localhost
DB_PORT=3306
DB_USER=flip7_app
DB_PASSWORD=replace_with_a_strong_password
DB_NAME=flip7_online
DB_CONNECTION_LIMIT=10

# Login sessions. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_at_least_32_random_characters
SESSION_MAX_AGE_HOURS=168

# Google OAuth 2.0 (see docs/10-setup-requirements-and-compatibility.md)
GOOGLE_CLIENT_ID=replace_with_your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret
# In development the callback goes through the Vite dev server (same origin as the app):
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Seconds the room creator has to answer "start now?" and to wait before being asked again
# after answering No. The agreed value is 120 (2 minutes).
ROOM_START_PROMPT_SECONDS=120

# How long a disconnected player keeps their seat before being removed from the room.
ROOM_DISCONNECT_GRACE_SECONDS=30

# Time limit for each move in a game; when it runs out the player automatically Stays.
GAME_TURN_SECONDS=15
# Pause between rounds (round summary on screen) before the next round starts.
GAME_ROUND_END_SECONDS=8

# Max sign-in / account-creation requests per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=30

# Set to true to also run the database integration tests (they need a running MySQL).
RUN_DB_TESTS=false
